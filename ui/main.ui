                       <height>31</height>
                      </size>
                     </property>
                     <property name="toolTip">
                      <string>Statistics report of the visible groups: every pair ranked by separation, mean ± SD, normality and pairwise tests (Welch t, Mann-Whitney U) of the crossovers and parameters; PDF and / or Excel (.xlsx, also for LibreOffice)</string>
                     </property>
                     <property name="styleSheet">
                      <string notr="true">/* Default State */
QPushButton {
    border: none;
	background: transparent;  /* Ghost button with no background */
    color: #0F172A;  /* Text color */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
	padding: 4px 8px 4px 4px;
}

/* Hover State */
QPushButton:hover {
    background: #F1F5F9;  /* slate/100 */
}

/* Pressed State */
QPushButton:pressed {
    background: #DEE8F2;  /* Pressed background color */
}</string>
                     </property>
                     <property name="text">
                      <string>Statistics report</string>
                     </property>
