                     </property>
                     <property name="toolTip">
                      <string>Show or hide the single points in Group plots: frequencies measured in only one replicate (open markers, no SD)</string>
                     </property>
                     <property name="styleSheet">
                      <string notr="true">/* Default State */
QCheckBox {
    border: none;
	background: transparent;  /* Ghost button with no background */
    color: #0F172A;  /* Text color */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
	padding: 4px;
}

QCheckBox:hover {
	 background: #F1F5F9;  /* slate/100 */
}

QCheckBox:pressed {
	background: #DEE8F2;  /* Pressed background color */
}

QCheckBox::indicator:checked {
	image: url(:/ui/qt/resources/checkbox/visible_icon.png);
}

QCheckBox::indicator:unchecked {
	image: url(:/ui/qt/resources/checkbox/hiden_icon.png);
}</string>
                     </property>
                     <property name="text">
                      <string>Single points</string>
                     </property>
                     <property name="checked">
