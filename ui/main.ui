                  <property name="styleSheet">
                   <string notr="true">/* Same sizes and output style as the cards of Curve plots and Group plots */
QFrame#qt_frame_separation {
	background: #FFFFFF;
	border: 1px solid #E2E8F0;  /* slate/200 */
	border-radius: 6px;
}

QLabel {
	border: none;
	background: transparent;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-weight: 500;
	font-size: 14px;
}

QLabel[muted=&quot;true&quot;] {
	padding: 4px 8px;
}

QLabel[value=&quot;true&quot;] {
	background: #F8FAFC;  /* slate/50 */
	border: 1px solid #E2E8F0;  /* slate/200 */
	border-radius: 6px;
	color: #334155;  /* slate/700 */
	padding: 5px 8px;
}

QLabel#qt_label_separation_title {
	font-size: 18px;
	padding: 4px 5px;
}</string>
