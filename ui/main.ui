    <item>
     <widget class="QFrame" name="qt_frame_header">
      <property name="styleSheet">
       <string notr="true">QFrame#qt_frame_header {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
}

QLabel {
	border: none;
	background: transparent;
	color: #0F172A;  /* Text color */
	font-family: 'Segoe UI', sans-serif;
	font-style: normal;
}

/* Default State */
QPushButton {
    border: none;
	background: transparent;  /* Ghost button with no background */
    color: #0F172A;  /* Text color */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    line-height: 24px;  /* Line height */
    padding: 6px 12px;  /* Padding */
}

/* Hover State */
QPushButton:hover {
    background: #F1F5F9;  /* slate/100 */
}

/* Pressed State */
QPushButton:pressed {
    background: #DEE8F2;  /* Pressed background color */
}

QPushButton:disabled {
    color: #94A3B8;  /* slate/400 */
}</string>
      </property>
