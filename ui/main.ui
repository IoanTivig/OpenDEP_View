               <item>
                <widget class="QCheckBox" name="qt_checkbox_graph_size_lock">
                 <property name="minimumSize">
                  <size>
                   <width>31</width>
                   <height>31</height>
                  </size>
                 </property>
                 <property name="maximumSize">
                  <size>
                   <width>31</width>
                   <height>31</height>
                  </size>
                 </property>
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Lock Graph Size&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">/* Default State */
QCheckBox {
    border: none;    
	background: transparent;  /* Ghost button with no background */
    color: #0F172A;  /* Text color */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    line-height: 24px;  /* Line height */
	padding: 4px;	
}

QCheckBox:hover {
    /* Your styles for hover state */
	 background: #F1F5F9;  /* slate/100 */

}

QCheckBox:pressed {
    /* Your styles for pressed state */
	background: #DEE8F2;  /* Pressed background color */

}

QCheckBox::indicator:checked {
    /* Your styles for checked state */
	image: url(:/ui/qt/resources/buttons/lock_icon.png);
}

QCheckBox::indicator:unchecked {
    /* Your styles for checked state */
	image: url(:/ui/qt/resources/buttons/unlock_icon.png);
}

QCheckBox:focused {
    border: none;
}

</string>
                 </property>
                 <property name="text">
                  <string/>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QLineEdit" name="qt_entry_graph_width">
                 <property name="enabled">
                  <bool>true</bool>
                 </property>
                 <property name="maximumSize">
                  <size>
                   <width>75</width>
                   <height>16777215</height>
                  </size>
                 </property>
                 <property name="toolTip">
                  <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Graph Height&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                 </property>
                 <property name="styleSheet">
                  <string notr="true">QLineEdit {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #CBD5E1;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    line-height: 24px;  /* Line height */
    padding: 4px 8px;  /* Padding */
    /* Adding icon to the beginning */
    background-image: url(:/ui/qt/resources/buttons/width_entry_icon.png);
    background-repeat: no-repeat;
    background-position: left center;
    padding-left: 24px; /* Adjust padding to avoid text overlaying the icon */
}

/* Disabled State */
QLineEdit:disabled {
    color: #D2D7DD;
    border: 1px solid #D2D7DD;
}
</string>
                 </property>
                 <property name="text">
                  <string>600</string>
                 </property>
                </widget>
