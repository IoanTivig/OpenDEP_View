  <property name="styleSheet">
   <string notr="true">QDialog#BugSignInDialog {
	background: #FFFFFF;
}

QLabel {
	border: none;
	background: transparent;
	color: #0F172A;  /* Text color */
	font-family: 'Segoe UI', sans-serif;
	font-weight: 600;
	font-size: 14px;
}

QLabel[muted=&quot;true&quot;] {
	color: #64748B;  /* slate/500 */
	font-weight: 400;
	font-size: 13px;
}

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #0F172A;
    font-family: 'Segoe UI', sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 4px 8px;
    min-height: 22px;
}

/* Outline buttons */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    font-family: 'Segoe UI', sans-serif;
    font-weight: 500;
    font-size: 14px;
    color: #0F172A;
    padding: 6px 16px;
}

QPushButton:hover {
    background: #F1F5F9;
}

/* Primary button */
QPushButton#qt_button_signin {
    background-color: #0F172A;
    border: none;
    color: #FFFFFF;
}

QPushButton#qt_button_signin:hover {
    background-color: #334155;
}

QPushButton#qt_button_signin:disabled {
    background-color: #CBD5E1;
}</string>
