  <property name="windowTitle">
   <string>OpenDEP View - User Guide</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#HelpWidget {
	background: #F1F5F9;
}

QFrame#qt_frame_help_card, QFrame#qt_frame_help_contents {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
}

QFrame#qt_frame_help_toolbar {
	background: transparent;
	border: none;
}

QLabel {
	border: none;
	background: transparent;
	color: #64748B;  /* slate/500 */
	font-family: 'Segoe UI', sans-serif;
	font-weight: 400;
	font-size: 13px;
}

QLineEdit {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #CBD5E1;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    padding: 4px 8px;  /* Padding */
}

/* Outline buttons */
QPushButton {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #E2E8F0;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    color: #0F172A;  /* Text color */
    padding: 5px 14px;  /* Padding */
}

QPushButton:hover {
    background: #F1F5F9;  /* Hover background */
}

QPushButton:pressed {
    background: #DEE8F2;  /* Pressed background */
}

QPushButton:disabled {
    color: #CBD5E1;
}

/* Contents */
QTreeWidget {
	background: transparent;
	border: none;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-size: 14px;
	outline: 0;
}

QTreeWidget::item {
	padding: 4px 2px;
	border-radius: 4px;
}

QTreeWidget::item:hover {
	background: #F1F5F9;  /* slate/100 */
}

QTreeWidget::item:selected {
	background: #DEE8F2;
	color: #0F172A;
}

/* Page */
QTextBrowser {
	background: #FFFFFF;
	border: 1px solid #E2E8F0;
	border-radius: 6px;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-size: 14px;
	padding: 8px 14px;
}

QSplitter::handle {
	background: transparent;
}

/* Slim scroll bars as in the plot lists of the main window */
QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 0px 0px 0px 2px;
	border: none;
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 2px 0px 0px 0px;
	border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
	background: #CBD5E1;  /* slate/300 */
	border-radius: 4px;
	min-height: 32px;
	min-width: 32px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
	background: #94A3B8;  /* slate/400 */
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
	background: #64748B;  /* slate/500 */
}

QScrollBar::add-line, QScrollBar::sub-line {
	width: 0px;
	height: 0px;
	border: none;
	background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}</string>
  </property>
