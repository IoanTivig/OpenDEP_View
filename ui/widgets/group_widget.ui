   <item>
    <widget class="QFrame" name="frame">
     <property name="styleSheet">
      <string notr="true">QFrame#frame {
	background: #FFFFFF;
	border: none;
	border-radius: 6px;
}
QFrame#frame:hover {
	 border: 1px solid #CBD5E1;
}

/* Cards inside the group (results, parameter groups, replicates) */
QFrame[card=&quot;true&quot;] {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
}

QLabel {
	border: none;
	background: transparent;
	color: #0F172A;  /* Text color */
	font-family: 'Segoe UI', sans-serif;  /* Font family */
	font-style: normal;  /* Font style */
	font-weight: 500;  /* Font weight */
	font-size: 14px;  /* Font size */
}

/* Card titles and parameter names as in the curve widget (Curve plots) */
QLabel[title=&quot;true&quot;] {
	font-size: 18px;
	padding: 4px 5px;
}

QLabel[parameter=&quot;true&quot;] {
	padding: 4px 8px;
}

QLabel[muted=&quot;true&quot;] {
	color: #64748B;  /* slate/500 */
	font-weight: 400;
	font-size: 13px;
}

/* Results: read-only values (output style, the same in all cards) */
QLabel[value=&quot;true&quot;] {
	background: #F8FAFC;  /* slate/50 */
	border: 1px solid #E2E8F0;  /* slate/200 */
	border-radius: 6px;
	color: #334155;  /* slate/700 */
	padding: 5px 8px;
}

QLineEdit {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #CBD5E1;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    padding: 4px 8px;  /* Padding */
}

QComboBox {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
	padding-left: 9px;
	color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
}

/* Drop-down button */
QComboBox::drop-down {
    border: none;
}

/* Down arrow */
QComboBox::down-arrow {
    image: url(:/ui/qt/resources/checkbox/down_icon.png);
	padding-right: 12px;
}

/* Drop-down items */
QComboBox QAbstractItemView {
    border: 1px solid #E2E8F0; /* slate/200 */
    selection-background-color: #F1F5F9;
}

/* Individual items */
QComboBox::item {
    background-color: white;
    color: #0F172A;
}

QDoubleSpinBox {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
	color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
}

QDoubleSpinBox::up-button {
	background: #FFFFFF;
	border: none;
	subcontrol-position: center right;
	padding-right: 6px;
}

QDoubleSpinBox::down-button {
	background: #FFFFFF;
	border: none;
	subcontrol-position: center left;
	padding-left: 6px;
}

QDoubleSpinBox::up-arrow {
	image: url(:/ui/qt/resources/buttons/add_icon.png);
	width: 16px;
    height: 16px;
}

QDoubleSpinBox::down-arrow {
	image: url(:/ui/qt/resources/buttons/substract_icon.png);
	width: 16px;
    height: 16px;
}

QTableWidget {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-size: 13px;
	gridline-color: #F1F5F9;
	selection-background-color: #DEE8F2;
	selection-color: #0F172A;
}

QHeaderView::section {
	background: #F8FAFC;
	border: none;
	border-bottom: 1px solid #E2E8F0;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-weight: 600;
	font-size: 13px;
	padding: 4px;
}

/* Colour button */
QPushButton#qt_button_pick_group_color {
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

/* Icon buttons */
QPushButton[icon_button=&quot;true&quot;] {
    border: none;
	background: transparent;  /* Ghost button with no background */
    border-radius: 6px;  /* Rounded corners */
	padding: 4px;
}

QPushButton[icon_button=&quot;true&quot;]:hover {
    background: #F1F5F9;  /* slate/100 */
}

QPushButton[icon_button=&quot;true&quot;]:pressed {
    background: #DEE8F2;  /* Pressed background color */
}

QPushButton#qt_button_export_group {
	image: url(:/ui/qt/resources/buttons/upload_file_icon.png);
}

QPushButton#qt_button_export_group_table {
	image: url(:/ui/qt/resources/buttons/upload_excel_icon.png);
}

QPushButton#qt_button_delete_group {
	image: url(:/ui/qt/resources/buttons/trash_icon.png);
}</string>
