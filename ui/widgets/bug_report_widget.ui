  </property>
  <property name="windowTitle">
   <string>OpenDEP View - Report a Bug</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#BugReportWidget {
	background: #F1F5F9;
}

QFrame#qt_frame_bug_card {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
}

/* The main window's background must not show inside the card */
QFrame#qt_frame_tabbar_bug, QWidget#qt_frame_bug_new, QWidget#qt_frame_bug_list {
	background: transparent;
	border: none;
}

QLabel {
	border: none;
	background: transparent;
	color: #0F172A;  /* Text color */
	font-family: 'Segoe UI', sans-serif;
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
}

QLabel[muted=&quot;true&quot;] {
	color: #64748B;  /* slate/500 */
	font-weight: 400;
	font-size: 13px;
}

QLineEdit, QPlainTextEdit {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #CBD5E1;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-style: normal;  /* Font style */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    padding: 4px 8px;  /* Padding */
}

QPlainTextEdit[readOnly=&quot;true&quot;] {
	background: #F8FAFC;
	font-family: 'Consolas', monospace;
	font-size: 12px;
}

QCheckBox {
    border: none;
    background: transparent;
    color: #0F172A;  /* Text color */
    font-family: 'Segoe UI', sans-serif;  /* Font family */
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    padding: 2px 0px;
    spacing: 8px;  /* Space between checkbox and text */
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
	image: url(:/ui/qt/resources/checkbox/chckbox_unchecked.png);  /* Unchecked icon */
}

QCheckBox::indicator:checked {
   image: url(:/ui/qt/resources/checkbox/chckbox_checked.png);  /* Checked icon */
}

/* Outline buttons */
QPushButton {
    background: #FFFFFF;  /* Default background */
    border: 1px solid #E2E8F0;  /* Default border */
    border-radius: 6px;  /* Rounded corners */
    font-family: 'Segoe UI', sans-serif;
    font-weight: 500;  /* Font weight */
    font-size: 14px;  /* Font size */
    color: #0F172A;  /* Text color */
    padding: 6px 16px;  /* Padding */
}

QPushButton:hover {
    background: #F1F5F9;  /* Hover background */
}

QPushButton:pressed {
    background: #DEE8F2;  /* Pressed background */
}

/* Primary button */
QPushButton#qt_button_bug_save {
    background-color: #0F172A;  /* Primary background color */
    border: none;
    color: #FFFFFF;  /* Text color */
}

QPushButton#qt_button_bug_save:hover {
    background-color: #334155;  /* Hover background color */
}

QPushButton#qt_button_bug_save:pressed {
    background-color: #5F728C;  /* Pressed background color */
}

/* Tab bar: ghost buttons, the active one highlighted */
QFrame#qt_frame_tabbar_bug QPushButton {
    border: none;
	background: transparent;
    padding: 8px 16px;
}

QFrame#qt_frame_tabbar_bug QPushButton:hover {
    background: #F1F5F9;  /* slate/100 */
}

QFrame#qt_frame_tabbar_bug QPushButton[customState=&quot;true&quot;] {
    background: #DEE8F2;  /* Pressed background color */
}

QTableWidget {
	background: #FFFFFF;
	border: 1px solid #E2E8F0; /* slate/200 */
	border-radius: 6px;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-size: 13px;
	gridline-color: #F1F5F9;
	selection-background-color: #DEE8F2;
	selection-color: #0F172A;
}

QHeaderView::section {
	background: #F8FAFC;
	border: none;
	border-bottom: 1px solid #E2E8F0;
	color: #0F172A;
	font-family: 'Segoe UI', sans-serif;
	font-weight: 600;
	font-size: 13px;
	padding: 6px;
}</string>
